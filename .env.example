# ------------------------------------------------------------------
# Engineering Resource Planner - environment configuration
# Copy to .env (local development) and adjust values.
# ------------------------------------------------------------------

# ---- Backend (apps/server) ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp?schema=public
# Comma separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:5173
# Whether the session cookie is marked Secure. True when behind HTTPS.
COOKIE_SECURE=false
# Secret used to sign cookies (not strictly required with opaque tokens, kept for compat).
COOKIE_SECRET=change-me-in-production
# Session lifetime in hours.
SESSION_TTL_HOURS=12
# Rate limiting for /auth (requests per window).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Trust proxy (behind nginx). Set to 1 in production.
TRUST_PROXY=1

# ---- Frontend (apps/web) ----
# Backend URL used by the Vite dev server proxy.
VITE_API_TARGET=http://localhost:4000