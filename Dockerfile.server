# ---- Build stage ----
FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/server/prisma/schema.prisma apps/server/prisma/schema.prisma

RUN npm ci

COPY . .

ENV CI=1
RUN npm run build

RUN npm prune --omit=dev

# ---- Runtime stage ----
FROM node:22-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4000

COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/server/dist /app/apps/server/dist
COPY --from=build /app/apps/server/prisma /app/apps/server/prisma
COPY --from=build /app/apps/server/package.json /app/apps/server/package.json
COPY --from=build /app/apps/web/dist /app/apps/web/dist

COPY infra/docker/entrypoint.sh /entrypoint.sh
COPY infra/docker/wait-for-db.js /wait-for-db.js
COPY infra/docker/seed-if-empty.js /seed-if-empty.js

RUN chmod +x /entrypoint.sh

EXPOSE 4000
CMD ["/entrypoint.sh"]